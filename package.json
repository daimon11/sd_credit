{
    "name": "@domrf/elka-salary",
    "version": "1.2.0",
    "license": "UNLICENSED",
    "repository": {
        "type": "git",
        "url": ""
    },
    "files": [
        "dist",
        "package.json",
        "README.md"
    ],
    "engines": {
        "node": ">=20.11.0"
    },
    "scripts": {
        "start": "webpack serve --mode=development",
        "start:standalone": "webpack serve --env standalone",
        "build": "concurrently \"npm:build:*\" --kill-others-on-fail",
        "build:types": "tsc --emitDeclarationOnly --declaration",
        "build:webpack": "webpack --mode=production",
        "build:lint": "",
        "build:stylelint": "",
        "stylelint": "stylelint 'src/**/*.{css,scss}' --fix",
        "lint-staged": "lint-staged --quiet",
        "analyze": "webpack --mode=production --env analyze",
        "lint": "eslint src --ext js,ts,tsx --fix",
        "format": "prettier --write .",
        "check-format": "prettier --check .",
        "sonar": "node sonarqube-scanner.js",
        "test": "jest",
        "test:watch": "jest --watch",
        "test:coverage": "jest --coverage",
        "test:ci": "jest --ci --coverage --config ./package.json",
        "coverage": "jest --coverage",
        "watch-tests": "jest --watch",
        "updateSnapshot": "jest --updateSnapshot",
        "updateTypes": "npm run getSchemas && npm run generateTypes",
        "getSchemas": "npx tsx ./types/getSchemas",
        "check": "npm run build:types && npm run lint-staged && npm run test",
        "prepare": "husky",
        "generateTypes": "npx openapi-typescript ./types/schemas/bff.json -o ./types/schemas/bff.d.ts && npx openapi-typescript ./types/schemas/payment-bff.json -o ./types/schemas/payment-bff.d.ts",
        "apply-overrides-force": "npm run apply-overrides && rmdir /s /q node_modules && del package-lock.json && npm install",
        "apply-overrides": "apply-overrides"
    },
    "prettier": {},
    "lint-staged": {
        "src/**/*.{js,jsx,ts,tsx}": [
            "eslint --fix"
        ],
        "src/**/*.{css,scss}": [
            "stylelint --fix"
        ]
    },
    "jestTestResultProcessors": [
        "jest-junit",
        "jest-sonar-reporter"
    ],
    "jest": {
        "testEnvironment": "jsdom",
        "moduleNameMapper": {
            "^src/(.*)$": "<rootDir>/src/$1",
            "^@components/(.*)$": "<rootDir>/src/components/$1",
            "^@layout/(.*)$": "<rootDir>/src/layout/$1",
            "^@redux/(.*)$": "<rootDir>/src/redux/$1",
            "^@pages/(.*)$": "<rootDir>/src/pages/$1",
            "^@api/(.*)$": "<rootDir>/src/api/$1",
            "^@types/(.*)$": "<rootDir>/src/types/$1",
            "^@hooks/(.*)$": "<rootDir>/src/hooks/$1",
            "^@stories/(.*)$": "<rootDir>/stories/$1",
            "^@mock/(.*)$": "<rootDir>/mock/$1",
            "\\.(css|scss|less)$": "identity-obj-proxy",
            "\\.(png|jpe?g|gif|svg|ttf|woff2?|eot|mdx)$": "<rootDir>/mock/fileMock.js",
            "^@ahml/elka_sign/(.*)$": "<rootDir>/mock/domrf_elka_sign/$1",
            "^@module-federation/enhanced/runtime$": "<rootDir>/mock/@module-federation/enhanced/runtime.js"
        },
        "coveragePathIgnorePatterns": [
            "/node_modules/"
        ],
        "collectCoverageFrom": [
            "src/**/*.{ts,tsx}"
        ],
        "testResultsProcessor": "jest-multiple-result-processors",
        "transform": {
            "^.+\\.(t|j)sx?$": "@swc/jest",
            "^.+\\.(css|styl|less|sass|scss)$": "jest-transform-css"
        },
        "transformIgnorePatterns": [
            "/node_modules/(?!@babel/runtime/helpers/esm/domrf-ui)"
        ],
        "globalSetup": "<rootDir>/configs/jest.global.setup.js",
        "setupFilesAfterEnv": [
            "@testing-library/jest-dom",
            "<rootDir>/configs/jest.setup.ts"
        ]
    },
    "jestSonar": {
        "reportPath": "coverage",
        "reportFile": "sonar-report.xml",
        "indent": 4
    },
    "devDependencies": {
        "@faker-js/faker": "^8.4.1",
        "@storybook/addon-essentials": "^7.6.15",
        "@storybook/addon-interactions": "^7.6.15",
        "@storybook/addon-links": "^7.6.15",
        "@storybook/addon-onboarding": "^1.0.11",
        "@storybook/blocks": "^7.6.15",
        "@storybook/react": "^7.6.15",
        "@storybook/react-webpack5": "^7.6.15",
        "@storybook/test": "^7.6.15",
        "@swc/core": "^1.5.6",
        "@swc/jest": "^0.2.36",
        "@swc/register": "^0.1.10",
        "@testing-library/dom": "latest",
        "@testing-library/jest-dom": "5.14.1",
        "@testing-library/react": "12.0.0",
        "@testing-library/react-hooks": "^8.0.1",
        "@types/jest": "27.0.1",
        "@types/node": "17.0.40",
        "@types/react": "17.0.13",
        "@types/react-dom": "17.0.13",
        "@types/react-router": "5.1.17",
        "@types/react-router-dom": "5.3.2",
        "@types/systemjs": "6.1.1",
        "@types/testing-library__jest-dom": "5.14.1",
        "@types/webpack-env": "1.16.2",
        "classnames": "2.3.1",
        "concurrently": "7.6.0",
        "cross-env": "7.0.3",
        "eslint": "8.57.0",
        "html-webpack-plugin": "5.5.0",
        "husky": "9.0.6",
        "identity-obj-proxy": "3.0.0",
        "jest": "27.0.5",
        "jest-cli": "27.0.5",
        "jest-css-modules-transform": "4.3.0",
        "jest-fetch-mock": "3.0.3",
        "jest-junit": "13.0.0",
        "jest-multiple-result-processors": "0.0.4",
        "jest-sonar-reporter": "2.0.0",
        "jest-transform-css": "6.0.1",
        "less": "4.1.2",
        "less-loader": "12.0.0",
        "lint-staged": "16.2.7",
        "mini-css-extract-plugin": "2.2.2",
        "msw": "1.2.2",
        "openapi-typescript": "6.3.4",
        "prettier": "3.0.0",
        "pretty-quick": "3.1.1",
        "react-number-format": "4.7.3",
        "react-scrollbars-custom": "4.0.27",
        "sass": "1.39.0",
        "sass-loader": "12.1.0",
        "sonarqube-scanner": "2.8.1",
        "stylelint": "16.23.1",
        "swc-loader": "0.2.6",
        "tsx": "3.14.0",
        "typescript": "^5.2.0",
        "webpack": "5.90.3",
        "webpack-cli": "5.1.4",
        "webpack-config-single-spa": "5.3.1",
        "webpack-dev-server": "4.0.0",
        "webpack-merge": "5.8.0",
        "whatwg-fetch": "3.6.20"
    },
    "dependencies": {
        "@module-federation/enhanced": "^0.3.5",
        "@reduxjs/toolkit": "^1.9.5",
        "@sentry/react": "^7.91.0",
        "@sentry/webpack-plugin": "^4.6.1",
        "@tanstack/react-table": "^8.21.3",
        "ajv": "^8.17.1",
        "react": "17.0.2",
        "react-dom": "17.0.2",
        "react-redux": "7.2.6",
        "react-router-dom": "6.2.1",
        "react-toastify": "9.1.3",
        "redux": "4.1.2",
        "redux-saga": "1.1.3",
        "resolve-url-loader": "5.0.0",
        "style-loader": "3.2.1",
        "ts-loader": "9.2.6"
    },
    "types": "dist/domrf-react-template.d.ts",
    "resolutions": {
        "@types/react": "17.0.40",
        "@types/react-dom": "17.0.13"
    },
    "overrides": {
        "debug": "4.4.1",
        "lodash": "4.17.21",
        "decompress": "4.2.1",
        "html-minifier-terser": ">=7.0.0 <7.2.0",
        "decode-uri-component": "0.4.1",
        "file-type": ">=16.5.4 <17.0.0",
        "follow-redirects": "1.15.4",
        "got": "12.1.0",
        "json5": "2.2.2",
        "kind-of": "6.0.3",
        "minimatch@3.0.5": "3.0.5",
        "minimatch@10.0.3": "10.0.3",
        "postcss@8.4.31": "8.4.31"
    }
}
